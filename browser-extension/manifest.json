{
  "manifest_version": 3,
  "name": "Study Coach - YouTube Tracker",
  "version": "0.1.0",
  "description": "Theo dõi tiến độ playlist C++ trên YouTube trong Brave, Edge hoặc Chrome và gửi về Study Coach local.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8780/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://www.youtube.com/watch*"], "js": ["youtube.js"], "run_at": "document_idle"}
  ],
  "action": {"default_title": "Study Coach", "default_popup": "popup.html"}
}