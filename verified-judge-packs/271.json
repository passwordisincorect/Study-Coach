  "reference_cpp": "#include <iostream>\n\n\n\n\n#include <string>\n\n\n\n\n#include <iomanip>\n\n\n\n\n#include <sstream>\n\n\n\n\nusing namespace std;\n\n\n\n\nstring pad(int x,int width){ostringstream o;o<<setfill('0')<<setw(width)<<x;return o.str();}\n\n\n\n\nint main(){string line,fmt;getline(cin,line);getline(cin,fmt);\n\n\n\n\nint y=stoi(line.substr(0,4)),M=stoi(line.substr(5,2)),d=stoi(line.substr(8,2)),h=stoi(line.substr(11,2)),m=stoi(line.substr(14,2)),s=stoi(line.substr(17,2));\n\n\n\n\nfor(size_t i=0;i<fmt.size();){string tail=fmt.substr(i);\n\n\n\n\nif(tail.rfind(\"yyyy\",0)==0){cout<<pad(y,4);i+=4;}\n\n\n\n\nelse if(tail.rfind(\"yy\",0)==0){cout<<pad(y%100,2);i+=2;}\n\n\n\n\nelse if(tail.rfind(\"MM\",0)==0){cout<<pad(M,2);i+=2;}\n\n\n\n\nelse if(tail.rfind(\"dd\",0)==0){cout<<pad(d,2);i+=2;}\n\n\n\n\nelse if(tail.rfind(\"hh\",0)==0){cout<<pad(h,2);i+=2;}\n\n\n\n\nelse if(tail.rfind(\"mm\",0)==0){cout<<pad(m,2);i+=2;}\n\n\n\n\nelse if(tail.rfind(\"ss\",0)==0){cout<<pad(s,2);i+=2;}\n\n\n\n\nelse{char c=fmt[i++];switch(c){case 'M':cout<<M;break;case 'd':cout<<d;break;case 'h':cout<<h;break;case 'm':cout<<m;break;case 's':cout<<s;break;default:cout<<c;}}}\n\n\n\n\ncout<<'\\n';}",
